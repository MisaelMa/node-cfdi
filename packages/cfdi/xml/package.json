{
  "name": "@cfdi/xml",
  "version": "4.0.21",
  "description": "Generacion, sellado y timbrado de XML CFDI 4.0 para Node.js - facturacion electronica Mexico",
  "homepage": "https://cfdi.recreando.dev",
  "bugs": {
    "url": "https://github.com/MisaelMa/node-cfdi/issues"
  },
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.cjs"
    },
    "./package.json": "./package.json"
  },
  "release": {
    "branches": [
      "main",
      "next",
      "beta"
    ]
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MisaelMa/node-cfdi.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build --config vite.config.lib.mts",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@cfdi/catalogos": "workspace:*",
    "@cfdi/csd": "workspace:*",
    "@cfdi/xsd": "workspace:*",
    "@cfdi/complementos": "workspace:*",
    "@cfdi/transform": "workspace:*",
    "@saxon-he/cli": "workspace:*",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@recreando/vite": "workspace:*",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.3",
    "@recreando/eslint-settings": "workspace:*",
    "@recreando/typescript-settings": "workspace:*",
    "@types/node": "^22",
    "eslint": "^8.57.0",
    "typescript": "^5.6.3",
    "vitest": "4.1.10",
    "vite-tsconfig-paths": "~4.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10"
  },
  "keywords": [
    "cfdi", "sat", "xml", "factura", "factura electronica", "facturacion",
    "mexico", "comprobante fiscal", "cfdi 4.0", "anexo 20", "sello",
    "timbrado", "cadena original", "certificado", "node", "typescript"
  ],
  "author": {
    "name": "Amir Misael Marin Coh",
    "email": "amisael.amir.misael@gmail.com",
    "url": "https://recreando.dev"
  }
}
