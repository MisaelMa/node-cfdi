{
  // Solo para `tsc --noEmit` (script `typecheck`). El tsconfig-base compartido mapea
  // `@cfdi/*` a `node_modules/@cfdi/*/src` y las incluye en `include`, lo que provoca
  // TS6059 con rootDir=src. Aquí el programa se limita a src/ y las dependencias se
  // resuelven por `paths` sin exigir que vivan bajo rootDir.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
